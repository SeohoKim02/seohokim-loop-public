{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-electron",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.cts", "electron/**/*.ts"]
}
